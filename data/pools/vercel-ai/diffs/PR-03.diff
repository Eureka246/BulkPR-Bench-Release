  * Normalizes a possibly undefined or non-array value into an array.
  */
 export function asArray<T>(value: Arrayable<T>): T[] {
-  return value === undefined ? [] : Array.isArray(value) ? value : [value];
+  if (value === undefined) {
+    return [];
+  }
+
+  if (Array.isArray(value)) {
