+package session
+
+import (
+	"testing"
+
+	"google.golang.org/genai"
+)
+
+func TestEventOutput(t *testing.T) {
+	explicit := &Event{Output: 42}
+	if got, ok := EventOutput(explicit); !ok || got != 42 {
+		t.Fatalf("explicit EventOutput() = (%v, %v), want (42, true)", got, ok)
+	}
+	message := &Event{NodeInfo: &NodeInfo{MessageAsOutput: true}}
+	message.LLMResponse.Content = &genai.Content{Role: "model", Parts: []*genai.Part{
+		{Text: "hidden", Thought: true}, {Text: "hello"}, {Text: " world"},
+	}}
+	if got, ok := EventOutput(message); !ok || got != "hello world" {
+		t.Fatalf("message EventOutput() = (%v, %v), want (hello world, true)", got, ok)
+	}
+	message.LLMResponse.Content = &genai.Content{Role: "user"}
+	if got, ok := EventOutput(message); ok || got != nil {
+		t.Fatalf("user EventOutput() = (%v, %v), want (nil, false)", got, ok)
+	}
+}
+
+func TestEventOutputPresenceRules(t *testing.T) {
+	tests := []struct {
+		name  string
+		event *Event
+		want  any
+		ok    bool
+	}{
+		{name: "nil event"},
+		{name: "no node metadata", event: &Event{}},
+		{
+			name:  "message flag without content",
+			event: &Event{NodeInfo: &NodeInfo{MessageAsOutput: true}},
+		},
+		{
+			name: "empty model message is present",
+			event: func() *Event {
+				event := &Event{NodeInfo: &NodeInfo{MessageAsOutput: true}}
+				event.LLMResponse.Content = &genai.Content{Role: "model"}
+				return event
+			}(),
+			want: "",
+			ok:   true,
+		},
+		{name: "explicit false", event: &Event{Output: false}, want: false, ok: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, ok := EventOutput(test.event)
+			if ok != test.ok || got != test.want {
+				t.Fatalf("EventOutput() = (%v, %v), want (%v, %v)", got, ok, test.want, test.ok)
+			}
+		})
+	}
+}
