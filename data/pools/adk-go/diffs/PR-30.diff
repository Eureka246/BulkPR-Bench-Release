+package session
+
+// EventOutput returns the explicit workflow output, or model text when the
+// event marks its message as output.
+func EventOutput(event *Event) (any, bool) {
+	if event == nil {
+		return nil, false
+	}
+	if event.Output != nil {
+		return event.Output, true
+	}
+	if event.NodeInfo == nil || !event.NodeInfo.MessageAsOutput {
+		return nil, false
+	}
+	content := event.LLMResponse.Content
+	if content == nil || content.Role != "model" {
+		return nil, false
+	}
+	var text []byte
+	for _, part := range content.Parts {
+		if part == nil || part.Text == "" || part.Thought {
+			continue
+		}
+		text = append(text, part.Text...)
+	}
+	return string(text), true
+}
