+package session
+
+import "slices"
+
+// Clone returns an independent copy of n.
+func (n *NodeInfo) Clone() *NodeInfo {
+	if n == nil {
+		return nil
+	}
+	return &NodeInfo{
+		Path:            n.Path,
+		MessageAsOutput: n.MessageAsOutput,
+		OutputFor:       slices.Clone(n.OutputFor),
+	}
+}
