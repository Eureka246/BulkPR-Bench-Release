+package schema
+
+import (
+	"context"
+	"fmt"
+)
+
+type IndexedToolCallJSONParseConfig struct {
+	ToolCallPosition int
+	ParseKeyPath     string
+}
+
+type indexedToolCallJSONParser[T any] struct {
+	position int
+	parser   *MessageJSONParser[T]
+}
+
+func NewIndexedToolCallJSONParser[T any](config *IndexedToolCallJSONParseConfig) MessageParser[T] {
+	if config == nil {
+		config = &IndexedToolCallJSONParseConfig{}
+	}
+	return &indexedToolCallJSONParser[T]{
+		position: config.ToolCallPosition,
+		parser:   &MessageJSONParser[T]{ParseFrom: MessageParseFromToolCall, ParseKeyPath: config.ParseKeyPath},
+	}
+}
+
+func (p *indexedToolCallJSONParser[T]) Parse(_ context.Context, message *Message) (parsed T, err error) {
+	if p.position < 0 || p.position >= len(message.ToolCalls) {
+		return parsed, fmt.Errorf("tool call position %d out of range", p.position)
+	}
+	return p.parser.parse(message.ToolCalls[p.position].Function.Arguments)
+}
