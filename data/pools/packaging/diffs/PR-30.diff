+def _membership_values(values: Collection[str]) -> tuple[str, ...]:
+    """Deduplicate and freeze marker membership values into a sorted tuple."""
+    return tuple(sorted(set(values)))
+
+
 def _get(d: Mapping[str, Any], expected_type: type[_T], key: str) -> _T | None:
     """Get a value from the dictionary and verify it's the expected type."""
     if (value := d.get(key)) is None:
@@ -784,12 +789,15 @@ class Pylock:
         #    #. ``extras`` SHOULD be set to the empty set by default.
         #    #. ``dependency_groups`` SHOULD be the set created from
         #       :ref:`pylock-default-groups` by default.
+        #    The membership values are frozen into sorted tuples so the
+        #    effective environment is deterministic, hashable and stable to
+        #    serialize regardless of how callers supplied them.
         env = cast(
-            "dict[str, str | frozenset[str]]",
+            "dict[str, str | Collection[str]]",
             dict(
                 environment or {},  # Marker.evaluate will fill-up
-                extras=frozenset(extras or []),
-                dependency_groups=frozenset(
+                extras=_membership_values(extras or []),
+                dependency_groups=_membership_values(
                     (self.default_groups or [])
