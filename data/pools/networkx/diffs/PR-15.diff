 __all__ = ["degree_centrality", "in_degree_centrality", "out_degree_centrality"]
 
 
+def _scaled_degrees(G, degree_view):
+    """Normalize a degree view by the maximum possible simple-graph degree."""
+    if len(G) <= 1:
+        return {n: 1 for n in G}
+    scale = 1.0 / (len(G) - 1.0)
+    return {n: d * scale for n, d in degree_view}
+
