+// Gateway Client module implements ring index behavior.
+/** Wraps an index into [0, length) for ring-buffer style access. */
+export function wrapIndex(index: number, length: number): number {
+  if (length <= 0) {
+    return 0;
+  }
+  return ((index % length) + length) % length;
+}
